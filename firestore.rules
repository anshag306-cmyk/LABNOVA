rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'anshag306@gmail.com') ||
        request.auth.token.role == 'superadmin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isLabMember(labId) {
      return isSignedIn() && (
        request.auth.token.labId == labId ||
        isSuperAdmin()
      );
    }

    function isLabAdmin(labId) {
      return isSignedIn() && (
        (request.auth.token.labId == labId && request.auth.token.role == 'admin') ||
        isSuperAdmin()
      );
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Laboratories collection - multi-tenant directories
    // ONLY Super Admin can create, delete, activate/deactivate, or manage any laboratory.
    // Normal Laboratory Admins and Staff must NOT have permission to delete, deactivate, edit, or manage other laboratories.
    match /laboratories/{labId} {
      allow read: if true;
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        isLabAdmin(labId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'id', 'ownerEmail'])
      );
      allow delete: if isSuperAdmin();
    }

    // Laboratory users and staff
    match /lab_users/{userId} {
      allow read: if true;
      allow create, update: if isSuperAdmin() || isLabAdmin(request.resource.data.labId);
      allow delete: if isSuperAdmin() || (isSignedIn() && isLabAdmin(resource.data.labId));
    }

    // Patients collection - strictly protected; requires authentication
    match /pathology_patients/{patientId} {
      allow read: if isSuperAdmin() || (isSignedIn() && (resource == null || isLabMember(resource.data.labId)));
      allow create: if isSuperAdmin() || (isSignedIn() && request.resource.data.labId != null && isLabMember(request.resource.data.labId));
      allow update: if isSuperAdmin() || (isSignedIn() && isLabMember(resource.data.labId));
      allow delete: if isSuperAdmin() || (isSignedIn() && isLabAdmin(resource.data.labId));
    }

    // Diagnostic Reports collection - strictly protected; requires authentication
    match /pathology_reports/{reportId} {
      allow read: if isSuperAdmin() || (isSignedIn() && (resource == null || isLabMember(resource.data.labId)));
      allow create: if isSuperAdmin() || (isSignedIn() && request.resource.data.labId != null && isLabMember(request.resource.data.labId));
      allow update: if isSuperAdmin() || (isSignedIn() && isLabMember(resource.data.labId));
      allow delete: if isSuperAdmin() || (isSignedIn() && isLabAdmin(resource.data.labId));
    }

    // Test templates and tariff catalog
    match /pathology_test_templates/{templateId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isSignedIn() && (resource == null || isLabAdmin(resource.data.labId) || isLabAdmin(request.resource.data.labId)));
    }

    // Laboratory branding and regulatory settings
    match /pathology_settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isLabAdmin(settingId);
    }
  }
}

